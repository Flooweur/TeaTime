{
  "name": "@teatime/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript, zero I/O: TeaTime's rules (time, the draw, the pantry, notifications, commands). SPEC §4.2.",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
