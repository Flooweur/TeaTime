# The daily stack's settings (docker-compose.yml; docs/runbook.md). Copy to .env at the repo root,
# which git ignores. Every line is optional except the VAPID keys, which `npm run daily:vapid` writes.

# The app's address on the tailnet: push links and where writes may come from.
# PUBLIC_ORIGIN=https://desktop-obf71rf.taild9afa4.ts.net:8443

# The PC's folder for the daily backups (30 kept).
# BACKUP_DIR=D:/TeaTime-backups

# Web push. Never commit or share the private key: new keys mean every phone subscribes again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:teatime@example.com
