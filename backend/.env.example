# The server's environment (src/config.ts). Copy to backend/.env for dev; every line is optional.
# Never commit backend/.env: the VAPID private key goes there.

# Where it listens. Dev: 127.0.0.1:3200. The container: 0.0.0.0 (phase 7).
# HOST=127.0.0.1
# PORT=3200

# The SQLite file. Dev: data/teatime.sqlite at the repo root (git ignores data/).
# DATABASE_PATH=

# "dev" or "daily", for the health route and the diagnostics.
# APP_ENV=dev

# The app's origin: the base of push links, and where writes may come from.
# PUBLIC_ORIGIN=http://localhost:5180
# Other origins writes may come from (comma-separated). Dev: Vite's preview. Empty on the daily stack.
# MORE_ORIGINS=http://localhost:5181

# The daily backups' folder. Unset: no backup job.
# BACKUP_DIR=

# Web push: `npm run vapid -w backend -- .env` writes these. Without both keys, pushes are off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:teatime@example.com
