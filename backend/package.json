{
  "name": "@teatime/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TeaTime's server: Fastify, SQLite and the jobs (SPEC §3). It stores the state, applies core's rules and sends the pushes.",
  "scripts": {
    "dev": "tsx watch --conditions=source src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "vapid": "tsx --conditions=source scripts/vapid.ts",
    "restore": "tsx --conditions=source scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "@teatime/content": "*",
    "@teatime/core": "*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "typebox": "1.4.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
