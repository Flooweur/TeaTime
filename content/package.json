{
  "name": "@teatime/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The blends, ingredients, shops, tea types and guides, as YAML and Markdown, with their schemas, checks and built bundle (SPEC §5).",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "source": "./src/bundle.ts",
      "types": "./dist/bundle.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "content:build": "tsx --conditions=source scripts/build.ts",
    "content:check": "tsx --conditions=source scripts/check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@teatime/core": "*",
    "marked": "18.2.1",
    "typebox": "1.4.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
