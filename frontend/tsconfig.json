{
  // The app. The service worker has its own config (src/sw/tsconfig.json): it runs in a worker, not a page.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/sw"]
}
